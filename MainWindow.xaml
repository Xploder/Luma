<Window x:Class="Luma.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Luma · Controller-Licht">
 <Grid x:Name="Root" RequestedTheme="Dark">
  <Grid.Resources>
   <SolidColorBrush x:Key="Accent" Color="#C9F27B"/>
   <SolidColorBrush x:Key="Subtle" Color="#A5ADB6"/>
   <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="#17212B"/><Setter Property="BorderBrush" Value="#2D3844"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/>
   </Style>
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16,10"/></Style>
  </Grid.Resources>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#101820" Offset="0"/><GradientStop Color="#15212B" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Padding="22,0,140,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE793;" FontSize="13" Foreground="{StaticResource Accent}"/><TextBlock Text="LUMA" FontSize="11" CharacterSpacing="220" Foreground="#B8C3CD"/></StackPanel></Grid>
  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Padding="36,18,36,26" Spacing="22" MaxWidth="1160" HorizontalAlignment="Stretch">
    <Grid>
     <StackPanel Spacing="6"><TextBlock Text="Weniger Licht. Mehr Spiel." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Dein Controller. Genau die richtige Helligkeit." Foreground="{StaticResource Subtle}" FontSize="14"/></StackPanel>
     <Button x:Name="TrayButton" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Tray_Click" ToolTipService.ToolTip="Im Infobereich weiterlaufen lassen"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE921;" FontSize="14"/><TextBlock Text="In den Tray"/></StackPanel></Button>
    </Grid>
    <Border Style="{StaticResource Card}" Padding="18,14">
     <Grid ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Background="#29382E" CornerRadius="12" Width="44" Height="44"><FontIcon Glyph="&#xE7FC;" FontSize="23" Foreground="{StaticResource Accent}"/></Border>
      <StackPanel Grid.Column="1" Spacing="4"><ComboBox x:Name="Controllers" PlaceholderText="Controller wird gesucht …" MinWidth="280" BorderThickness="0" Background="Transparent" SelectionChanged="Controller_Changed" AutomationProperties.Name="Controller auswählen"/><TextBlock x:Name="ConnectionText" Text="USB oder Xbox Wireless Adapter" Foreground="{StaticResource Subtle}" FontSize="12" Margin="12,0,0,0"/></StackPanel>
      <Button Grid.Column="2" x:Name="RefreshButton" Click="Refresh_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Controller erneut suchen" AutomationProperties.Name="Controller erneut suchen"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
     </Grid>
    </Border>
    <Grid ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="24">
      <Grid MinHeight="268">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><TextBlock Text="DEIN CONTROLLER" FontSize="10" CharacterSpacing="180" Foreground="{StaticResource Subtle}"/><Border HorizontalAlignment="Right" Background="#26372B" CornerRadius="9" Padding="9,4"><TextBlock x:Name="PreviewBadge" Text="LED-VORSCHAU" FontSize="9" CharacterSpacing="80" Foreground="{StaticResource Accent}"/></Border></Grid>
       <Viewbox Grid.Row="1" Margin="0,18,0,10" MaxHeight="190" Stretch="Uniform">
        <Canvas Width="360" Height="205">
         <Ellipse Width="220" Height="28" Fill="#090E14" Canvas.Left="70" Canvas.Top="172"/>
         <Path Data="M 89,35 C 61,28 43,46 32,78 L 12,151 C 3,191 39,211 60,178 L 92,143 L 268,143 L 300,178 C 321,211 357,191 348,151 L 328,78 C 317,46 299,28 271,35 C 226,47 134,47 89,35 Z" Stroke="#52616D" StrokeThickness="2">
          <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#394751" Offset="0"/><GradientStop Color="#202C37" Offset="1"/></LinearGradientBrush></Path.Fill>
         </Path>
         <Ellipse Width="56" Height="56" Fill="#14202A" Stroke="#52616D" StrokeThickness="2" Canvas.Left="65" Canvas.Top="59"/>
         <Ellipse Width="39" Height="39" Fill="#2F3D49" Stroke="#43535F" Canvas.Left="73.5" Canvas.Top="67.5"/>
         <Ellipse Width="50" Height="50" Fill="#14202A" Stroke="#52616D" StrokeThickness="2" Canvas.Left="215" Canvas.Top="111"/>
         <Ellipse Width="34" Height="34" Fill="#2F3D49" Stroke="#43535F" Canvas.Left="223" Canvas.Top="119"/>
         <Path Data="M 128,114 L 146,114 L 146,128 L 160,128 L 160,146 L 146,146 L 146,160 L 128,160 L 128,146 L 114,146 L 114,128 L 128,128 Z" Fill="#111D27" Stroke="#52616D"/>
         <Ellipse Width="22" Height="22" Fill="#15222C" Canvas.Left="269" Canvas.Top="55"/><TextBlock Text="Y" FontSize="12" Foreground="#D8C782" Canvas.Left="276" Canvas.Top="57"/>
         <Ellipse Width="22" Height="22" Fill="#15222C" Canvas.Left="292" Canvas.Top="78"/><TextBlock Text="B" FontSize="12" Foreground="#CE8D8D" Canvas.Left="299" Canvas.Top="80"/>
         <Ellipse Width="22" Height="22" Fill="#15222C" Canvas.Left="246" Canvas.Top="78"/><TextBlock Text="X" FontSize="12" Foreground="#8BA9D5" Canvas.Left="253" Canvas.Top="80"/>
         <Ellipse Width="22" Height="22" Fill="#15222C" Canvas.Left="269" Canvas.Top="101"/><TextBlock Text="A" FontSize="12" Foreground="#A8C68D" Canvas.Left="276" Canvas.Top="103"/>
         <Ellipse x:Name="LedGlow" Width="68" Height="68" Fill="#1DC9F27B" Canvas.Left="146" Canvas.Top="34"/>
         <Ellipse x:Name="LedDot" Width="28" Height="28" Fill="#C9F27B" Canvas.Left="166" Canvas.Top="54"/>
         <Path Data="M 171,58 C 177,61 183,67 190,77 M 189,58 C 181,61 176,68 170,77" Stroke="#23371A" StrokeThickness="2.5"/>
         <Rectangle Width="12" Height="3" Fill="#74818C" Canvas.Left="144" Canvas.Top="92"/><Rectangle Width="12" Height="3" Fill="#74818C" Canvas.Left="204" Canvas.Top="92"/>
        </Canvas>
       </Viewbox>
       <StackPanel Grid.Row="2" Spacing="4" HorizontalAlignment="Center"><TextBlock x:Name="PreviewTitle" Text="Angenehm dezent" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Vorschau der eingestellten Helligkeit" FontSize="11" Foreground="{StaticResource Subtle}" HorizontalAlignment="Center"/></StackPanel>
      </Grid>
     </Border>
     <Border Grid.Column="1" Style="{StaticResource Card}" Padding="26,22">
      <StackPanel Spacing="14">
       <Grid><TextBlock Text="Xbox-Logo" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><ToggleSwitch x:Name="LedEnabled" HorizontalAlignment="Right" OnContent="Ein" OffContent="Aus" Toggled="Led_Toggled" AutomationProperties.Name="Xbox-Logo einschalten"/></Grid>
       <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="BrightnessValue" Text="20" FontSize="60" FontWeight="SemiLight"/><TextBlock Text="%" FontSize="22" Foreground="{StaticResource Subtle}" VerticalAlignment="Bottom" Margin="0,0,0,12"/></StackPanel>
       <StackPanel Spacing="0"><Slider x:Name="Brightness" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Brightness_Changed" AutomationProperties.Name="LED-Helligkeit in Prozent"/><Grid><TextBlock Text="Aus" FontSize="11" Foreground="{StaticResource Subtle}"/><TextBlock Text="Maximal" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Subtle}"/></Grid></StackPanel>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button x:Name="NightButton" Tag="10" Click="Preset_Click" HorizontalAlignment="Stretch" Padding="8,10"><StackPanel Spacing="3"><TextBlock Text="Nacht" HorizontalAlignment="Center"/><TextBlock Text="10 %" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource Subtle}"/></StackPanel></Button>
        <Button Grid.Column="1" Tag="30" Click="Preset_Click" HorizontalAlignment="Stretch" Padding="8,10"><StackPanel Spacing="3"><TextBlock Text="Entspannt" HorizontalAlignment="Center"/><TextBlock Text="30 %" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource Subtle}"/></StackPanel></Button>
        <Button Grid.Column="2" Tag="100" Click="Preset_Click" HorizontalAlignment="Stretch" Padding="8,10"><StackPanel Spacing="3"><TextBlock Text="Hell" HorizontalAlignment="Center"/><TextBlock Text="100 %" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource Subtle}"/></StackPanel></Button>
       </Grid>
      </StackPanel>
     </Border>
    </Grid>
    <Grid ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="20,16"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE945;" FontSize="21" Foreground="{StaticResource Accent}"/><StackPanel Grid.Column="1" Spacing="9"><TextBlock Text="Lichtmodus" FontWeight="SemiBold"/><ComboBox x:Name="Modes" HorizontalAlignment="Stretch" SelectionChanged="Mode_Changed" AutomationProperties.Name="Lichtmodus"/></StackPanel></Grid></Border>
     <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,16"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5" VerticalAlignment="Center"><TextBlock Text="Beim Verbinden anwenden" FontWeight="SemiBold"/><TextBlock Text="Deine letzte Einstellung automatisch laden." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Subtle}"/></StackPanel><ToggleSwitch Grid.Column="1" x:Name="AutoApply" OnContent="" OffContent="" Toggled="AutoApply_Toggled" VerticalAlignment="Center" AutomationProperties.Name="Beim Verbinden automatisch anwenden"/></Grid></Border>
    </Grid>
    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
     <Expander.Header><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock Text="Einstellungen"/></StackPanel></Expander.Header>
     <StackPanel Spacing="18"><Grid><StackPanel Spacing="3"><TextBlock Text="Mit Windows starten"/><TextBlock Text="Luma startet unauffällig im Tray." FontSize="12" Foreground="{StaticResource Subtle}"/></StackPanel><ToggleSwitch x:Name="Startup" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="Startup_Toggled" AutomationProperties.Name="Mit Windows starten"/></Grid><Grid><TextBlock Text="Beim Schließen im Tray weiterlaufen" VerticalAlignment="Center"/><ToggleSwitch x:Name="CloseToTray" HorizontalAlignment="Right" OnContent="" OffContent="" Toggled="CloseToTray_Toggled" AutomationProperties.Name="Beim Schließen im Tray weiterlaufen"/></Grid><TextBlock Text="Ein gemeinsamer Standardwert für neu verbundene Controller. Änderungen betreffen den ausgewählten Controller." TextWrapping="Wrap" Foreground="{StaticResource Subtle}" FontSize="12"/><Button Content="Luma beenden" HorizontalAlignment="Left" Click="Quit_Click"/><HyperlinkButton Content="Basiert auf xbledctl · Open Source (MIT)" NavigateUri="https://github.com/Leclowndu93150/xbledctl" Padding="0"/></StackPanel>
    </Expander>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning"/>
    <Grid><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#78848F" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="Controller wird gesucht …" FontSize="11" Foreground="{StaticResource Subtle}"/></StackPanel><TextBlock Text="LUMA  /  1.0" HorizontalAlignment="Right" FontSize="10" CharacterSpacing="120" Foreground="#78848F"/></Grid>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>

