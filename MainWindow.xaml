<Window x:Class="Luma.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Luma" Title="Luma · Controller LED">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="#101820">
  <Grid.Resources>
   <SolidColorBrush x:Key="Subtle" Color="#A5ADB6"/>
   <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#17212B"/><Setter Property="BorderBrush" Value="#2D3844"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16,12"/></Style>
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,7"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent" Padding="18,0,140,0"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE793;" FontSize="14" Foreground="#C9F27B"/><TextBlock Text="LUMA" FontSize="11" CharacterSpacing="180" Foreground="#B8C3CD"/></StackPanel></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ScrollView ContentOrientation="Vertical" IgnoredInputKinds="MouseWheel" x:Name="MainScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" VerticalScrollMode="Enabled" ZoomMode="Disabled" Background="Transparent">
   <StackPanel x:Name="ContentPanel" Padding="18,8,18,16" Spacing="12" Background="Transparent">
<Border Style="{StaticResource Card}"><StackPanel Spacing="4">
     <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="Controllers" PlaceholderText="Controller wird gesucht …" HorizontalAlignment="Stretch" SelectionChanged="Controller_Changed" AutomationProperties.Name="Controller auswählen"/>
      <Button Grid.Column="1" x:Name="RefreshButton" Click="Refresh_Click" ToolTipService.ToolTip="Controller erneut suchen" AutomationProperties.Name="Controller erneut suchen"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
     </Grid>
     <TextBlock x:Name="ConnectionText" Text="USB oder Xbox Wireless Adapter" Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel Spacing="8">
     <Grid><TextBlock Text="Helligkeit" FontWeight="SemiBold" VerticalAlignment="Center"/><ToggleSwitch x:Name="LedEnabled" HorizontalAlignment="Right" OnContent="Ein" OffContent="Aus" Toggled="Led_Toggled" AutomationProperties.Name="Xbox-Logo einschalten"/></Grid>
     <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Slider x:Name="Brightness" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Brightness_Changed" AutomationProperties.Name="LED-Helligkeit in Prozent" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" x:Name="BrightnessValue" Text="20 %" FontSize="24" FontWeight="SemiLight" MinWidth="64" TextAlignment="Right" VerticalAlignment="Center"/>
     </Grid>
     <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="NightButton" Content="Nacht · 10 %" Tag="10" Click="Preset_Click" HorizontalAlignment="Stretch" FontSize="12" Padding="6,7"/>
      <Button Grid.Column="1" Content="Entspannt · 30 %" Tag="30" Click="Preset_Click" HorizontalAlignment="Stretch" FontSize="12" Padding="6,7"/>
      <Button Grid.Column="2" Content="Hell · 100 %" Tag="100" Click="Preset_Click" HorizontalAlignment="Stretch" FontSize="12" Padding="6,7"/>
     </Grid>
     <Grid ColumnSpacing="12" Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Lichtmodus" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Subtle}"/><ComboBox x:Name="Modes" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Mode_Changed" AutomationProperties.Name="Lichtmodus"/></Grid>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel Spacing="6">
     <TextBlock Text="Einstellungen" FontWeight="SemiBold" Margin="0,0,0,3"/>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Beim Verbinden anwenden" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" x:Name="AutoApply" OnContent="" OffContent="" Toggled="AutoApply_Toggled" AutomationProperties.Name="Beim Verbinden automatisch anwenden"/></Grid>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Mit Windows starten" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" x:Name="Startup" OnContent="" OffContent="" Toggled="Startup_Toggled" AutomationProperties.Name="Mit Windows starten"/></Grid>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Beim Schließen im Tray weiterlaufen" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" x:Name="CloseToTray" OnContent="" OffContent="" Toggled="CloseToTray_Toggled" AutomationProperties.Name="Beim Schließen im Tray weiterlaufen"/></Grid>
    </StackPanel></Border>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning"/>
    <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#78848F" VerticalAlignment="Center"/><TextBlock x:Name="Status" Text="Controller wird gesucht …" FontSize="11" Foreground="{StaticResource Subtle}" TextWrapping="Wrap" MaxWidth="380"/></StackPanel>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><HyperlinkButton Content="xbledctl · MIT · Luma 1.2" NavigateUri="https://github.com/Leclowndu93150/xbledctl" FontSize="11" Padding="0" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button x:Name="TrayButton" Content="In den Tray" FontSize="12" Click="Tray_Click"/><Button Content="Beenden" FontSize="12" Click="Quit_Click"/></StackPanel></Grid>
   </StackPanel>
  </ScrollView><ScrollBar x:Name="PageScrollBar" Grid.Column="1" Orientation="Vertical" IndicatorMode="MouseIndicator" Width="14" Margin="0,6,4,8" SmallChange="48" Minimum="0" Visibility="Collapsed" AutomationProperties.Name="Scroll"/></Grid>
 </Grid>
</Window>




